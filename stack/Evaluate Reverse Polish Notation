import java.util.Arrays;
import java.util.Stack;

/*
 * 150. Evaluate Reverse Polish Notation
 * Difficulty: Medium
 * https://leetcode.com/problems/evaluate-reverse-polish-notation/
 *
 * PROBLEM
 * Given an array of strings tokens representing an arithmetic
 * expression in Reverse Polish Notation, evaluate the expression
 * and return its integer result.
 *
 * Valid operators are "+", "-", "*", and "/".
 * Each operand is an integer or the result of another expression.
 * Integer division truncates toward zero.
 *
 * The expression is valid, there is no division by zero,
 * and all intermediate results fit in a 32-bit integer.
 *
 * EXAMPLE 1
 * Input:  tokens = ["2", "1", "+", "3", "*"]
 * Output: 9
 * Explanation: (2 + 1) * 3 = 9.
 *
 * EXAMPLE 2
 * Input:  tokens = ["4", "13", "5", "/", "+"]
 * Output: 6
 * Explanation: 4 + (13 / 5) = 4 + 2 = 6.
 *
 * CONSTRAINTS
 * 1 <= tokens.length <= 10000
 * Each token is an operator or an integer in [-200, 200].
 *
 * APPROACH
 * Read tokens from left to right.
 * Push numbers onto the stack.
 * For an operator, pop the right operand b first,
 * then pop the left operand a.
 * Calculate a operator b and push the result.
 * The final remaining stack element is the answer.
 *
 * COMPLEXITY
 * Time: O(n), where n is the number of tokens.
 * Extra space: O(n) for the stack.
 */

class Solution {
    public int evalRPN(String[] tokens) {
        String[] operators = {"+", "-", "*", "/"};
        Stack<Integer> s = new Stack<>();

        for (String token : tokens) {
            boolean hasOp = Arrays.asList(operators).contains(token);

            if (!hasOp) {
                s.push(Integer.parseInt(token));
            } else {
                int b = s.pop();
                int a = s.pop();
                s.push(operationFunc(a, b, token));
            }
        }

        return s.pop();
    }

    public static int operationFunc(int a, int b, String operator) {
        switch (operator) {
            case "+":
                return a + b;
            case "-":
                return a - b;
            case "*":
                return a * b;
            case "/":
                return a / b;
        }

        return 0;
    }
}
