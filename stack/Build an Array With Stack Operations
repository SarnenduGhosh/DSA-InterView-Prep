import java.util.ArrayList;
import java.util.List;

/*
 * 1441. Build an Array With Stack Operations
 * Difficulty: Medium
 * https://leetcode.com/problems/build-an-array-with-stack-operations/
 *
 * PROBLEM
 * Given a strictly increasing array target and an integer n,
 * read numbers from the stream 1, 2, ..., n in order.
 *
 * Use "Push" to add the next number to the stack.
 * Use "Pop" to remove the top number.
 *
 * Return the operations needed to make the stack equal to
 * target, from bottom to top. Stop immediately when it matches.
 *
 * EXAMPLE 1
 * Input:  target = [1, 3], n = 3
 * Output: ["Push", "Push", "Pop", "Push"]
 *
 * EXAMPLE 2
 * Input:  target = [1, 2, 3], n = 3
 * Output: ["Push", "Push", "Push"]
 *
 * EXAMPLE 3
 * Input:  target = [1, 2], n = 4
 * Output: ["Push", "Push"]
 *
 * CONSTRAINTS
 * 1 <= target.length <= 100
 * 1 <= n <= 100
 * 1 <= target[i] <= n
 * target is strictly increasing.
 *
 * APPROACH
 * Push each stream number and record "Push".
 * Keep it if it matches the next target number.
 * Otherwise, pop it and record "Pop".
 * Stop when every target number has been matched.
 *
 * COMPLEXITY
 * Time: O(m), where m is the last number in target.
 * Extra space: O(k) for the custom stack,
 * where k = target.length, excluding the returned list.
 */

class stack {
    int size;
    int top = -1;
    int[] arr;

    stack(int size) {
        this.size = size;
        this.arr = new int[size];
    }

    public boolean isFull() {
        return top == size - 1;
    }

    public boolean isEmpty() {
        return top < 0;
    }

    public int peek() {
        return arr[top];
    }

    public void push(int num) {
        if (!isFull()) {
            arr[++top] = num;
        }
    }

    public void pop() {
        if (!isEmpty()) {
            top--;
        }
    }
}

class Solution {
    public List<String> buildArray(int[] target, int n) {
        stack s = new stack(target.length);
        List<String> out = new ArrayList<>();
        int j = 0;

        for (int i = 1; i <= n && j < target.length; i++) {
            s.push(i);
            out.add("Push");

            if (s.peek() == target[j]) {
                j++;
            } else {
                s.pop();
                out.add("Pop");
            }
        }

        return out;
    }
}
