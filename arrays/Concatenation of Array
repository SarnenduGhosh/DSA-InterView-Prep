/*
 * 1929. Concatenation of Array
 * Difficulty: Easy
 * https://leetcode.com/problems/concatenation-of-array/
 *
 * PROBLEM
 * Given an integer array nums of length n, create an array ans
 * of length 2n such that:
 *
 * ans[i] = nums[i]
 * ans[i + n] = nums[i]
 *
 * for 0 <= i < n (0-indexed).
 *
 * The array ans is the concatenation of two nums arrays.
 * Return ans.
 *
 * EXAMPLE 1
 * Input:  nums = [1, 2, 1]
 * Output: [1, 2, 1, 1, 2, 1]
 *
 * EXAMPLE 2
 * Input:  nums = [1, 3, 2, 1]
 * Output: [1, 3, 2, 1, 1, 3, 2, 1]
 *
 * CONSTRAINTS
 * n == nums.length
 * 1 <= n <= 1000
 * 1 <= nums[i] <= 1000
 *
 * APPROACH
 * Create an array of length 2n.
 * Copy each number into positions i and i + n.
 *
 * COMPLEXITY
 * Time: O(n)
 * Space: O(n) for the output array.
 * Additional working space: O(1).
 */

class Solution {
    public int[] getConcatenation(int[] nums) {
        int len = nums.length;
        int[] output = new int[len * 2];

        for (int i = 0; i < len; i++) {
            output[i] = nums[i];
            output[i + len] = nums[i];
        }

        return output;
    }
}
