/*
 * 1470. Shuffle the Array
 * Difficulty: Easy
 * https://leetcode.com/problems/shuffle-the-array/
 *
 * PROBLEM
 * Given an array nums consisting of 2n elements in the form:
 * [x1, x2, ..., xn, y1, y2, ..., yn]
 *
 * Return the array in the form:
 * [x1, y1, x2, y2, ..., xn, yn]
 *
 * EXAMPLE 1
 * Input:  nums = [2, 5, 1, 3, 4, 7], n = 3
 * Output: [2, 3, 5, 4, 1, 7]
 * Explanation: Pair the elements from the two halves:
 * (2, 3), (5, 4), (1, 7).
 *
 * EXAMPLE 2
 * Input:  nums = [1, 2, 3, 4, 4, 3, 2, 1], n = 4
 * Output: [1, 4, 2, 3, 3, 2, 4, 1]
 *
 * EXAMPLE 3
 * Input:  nums = [1, 1, 2, 2], n = 2
 * Output: [1, 2, 1, 2]
 *
 * CONSTRAINTS
 * 1 <= n <= 500
 * nums.length == 2 * n
 * 1 <= nums[i] <= 1000
 *
 * APPROACH
 * Create an output array of length 2n.
 * For each i, calculate index = 2 * i + 1.
 * Place nums[i] at index - 1 and nums[i + n] at index.
 *
 * COMPLEXITY
 * Time: O(n)
 * Space: O(n) for the output array.
 * Additional working space: O(1).
 */

class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] output = new int[n * 2];
        return helper(nums, n, output);
    }

    public static int[] helper(int[] array, int n, int[] out) {
        for (int i = 0; i < n; i++) {
            int index = formula(i);
            out[index - 1] = array[i];
            out[index] = array[i + n];
        }

        return out;
    }

    public static int formula(int i) {
        return i * 2 + 1;
    }
}
