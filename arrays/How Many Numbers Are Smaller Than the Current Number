/*
 * 1365. How Many Numbers Are Smaller Than the Current Number
 * Difficulty: Easy
 * https://leetcode.com/problems/how-many-numbers-are-smaller-than-the-current-number/
 *
 * PROBLEM
 * Given an array nums, for each nums[i], count how many
 * elements nums[j] satisfy:
 * j != i and nums[j] < nums[i].
 *
 * Return the counts in an array, preserving the input order.
 *
 * EXAMPLE 1
 * Input:  nums = [8, 1, 2, 2, 3]
 * Output: [4, 0, 1, 1, 3]
 * Explanation:
 * 8 has four smaller elements: 1, 2, 2, 3.
 * 1 has no smaller elements.
 * Each 2 has one smaller element: 1.
 * 3 has three smaller elements: 1, 2, 2.
 *
 * EXAMPLE 2
 * Input:  nums = [6, 5, 4, 8]
 * Output: [2, 1, 0, 3]
 *
 * EXAMPLE 3
 * Input:  nums = [7, 7, 7, 7]
 * Output: [0, 0, 0, 0]
 *
 * CONSTRAINTS
 * 2 <= nums.length <= 500
 * 0 <= nums[i] <= 100
 *
 * APPROACH
 * Count occurrences using a frequency array of size 101.
 * Convert frequencies into prefix sums so freq[x] stores
 * the number of elements less than or equal to x.
 * For a positive value x, freq[x - 1] gives the number
 * of strictly smaller elements. For zero, the answer is zero.
 *
 * COMPLEXITY
 * Time: O(n), since the value range is fixed.
 * Extra space: O(1), excluding the output array.
 * Output space: O(n).
 */

class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
        int[] freq = new int[101];

        for (int num : nums) {
            freq[num]++;
        }

        for (int i = 1; i < freq.length; i++) {
            freq[i] += freq[i - 1];
        }

        int[] ans = new int[nums.length];

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] == 0) {
                ans[i] = 0;
            } else {
                ans[i] = freq[nums[i] - 1];
            }
        }

        return ans;
    }
}
